# Copy to .env and adjust.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=false

# Hostnames/IPs the app is reached by (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1,nas.local
# Full origins, needed for form posts when served over https or a non-default port
CSRF_TRUSTED_ORIGINS=http://nas.local:5001

# Set to true when behind a reverse proxy that terminates HTTPS
BEHIND_PROXY=false
SECURE_COOKIES=false

TIME_ZONE=Europe/Berlin
SITE_NAME=Chef

# Created/updated as admin on every container start (optional)
INITIAL_ADMIN_EMAIL=

# SMTP for login codes and notifications. Leave EMAIL_HOST empty to print emails to the container logs instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Chef <>

# Email the household (including whoever asked) when a menu is created or changed (true/false)
MENU_EMAILS=true

# Login code lifetime in seconds
LOGIN_CODE_MAX_AGE=600

# AI menu planning (https://platform.openai.com/api-keys). Leave empty to switch it off.
OPENAI_API_KEY=
# Optional: model (e.g. gpt-5.4-mini, gpt-6.1-sol) and reasoning effort (low, medium, high, xhigh)
AI_MODEL=gpt-5.4-mini
AI_EFFORT=medium
# What AI may cost per day in USD: per household (admins can change it per household) and for all together
AI_DAILY_LIMIT_USD=0.20
AI_GLOBAL_DAILY_LIMIT_USD=2.00

# Anyone can register a household (AI after an admin approves it). false: only with adduser.
REGISTRATION_OPEN=true
# Address of the app for links in emails (default: the first CSRF_TRUSTED_ORIGINS entry)
SITE_URL=
